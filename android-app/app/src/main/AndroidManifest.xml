<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LinguaAI"
        tools:targetApi="34">

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.LinguaAI.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.register.RegisterActivity"
            android:theme="@style/Theme.LinguaAI.NoActionBar" />

        <activity
            android:name=".ui.languageselection.LanguageSelectionActivity"
            android:theme="@style/Theme.LinguaAI.NoActionBar" />

        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:theme="@style/Theme.LinguaAI.NoActionBar" />

        <activity
            android:name=".ui.lesson.LessonActivity"
            android:theme="@style/Theme.LinguaAI.NoActionBar" />

        <activity
            android:name=".ui.statistics.StatisticsActivity"
            android:theme="@style/Theme.LinguaAI.NoActionBar" />

        <activity
            android:name=".ui.achievements.AchievementsActivity"
            android:theme="@style/Theme.LinguaAI.NoActionBar" />

        <activity
            android:name=".ui.vocabulary.VocabularyActivity"
            android:theme="@style/Theme.LinguaAI.NoActionBar" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:theme="@style/Theme.LinguaAI.NoActionBar" />

    </application>

</manifest>
